<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_dark"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etNum1"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="@string/hint_num1"
            android:inputType="numberDecimal|numberSigned"
            android:background="@color/card_bg"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/secondary_gray"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etNum2"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="@string/hint_num2"
            android:inputType="numberDecimal|numberSigned"
            android:background="@color/card_bg"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/secondary_gray"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Basic Arithmetic Buttons (+, -, ×, ÷) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/primary_blue"
                android:text="@string/btn_add"
                android:textSize="22sp"/>

            <Button
                android:id="@+id/btnSub"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/primary_blue"
                android:text="@string/btn_sub"
                android:textSize="22sp"/>

            <Button
                android:id="@+id/btnMul"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/primary_blue"
                android:text="@string/btn_mul"
                android:textSize="22sp"/>

            <Button
                android:id="@+id/btnDiv"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="@string/btn_div"
                android:textSize="22sp"/>
        </LinearLayout>

        <!-- Bonus Scientific Buttons (√, x², %) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSqrt"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/secondary_gray"
                android:text="@string/btn_sqrt"
                android:textSize="18sp"/>

            <Button
                android:id="@+id/btnSquare"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/secondary_gray"
                android:text="@string/btn_square"
                android:textSize="18sp"/>

            <Button
                android:id="@+id/btnPercent"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="@color/secondary_gray"
                android:text="@string/btn_percent"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Clear Button -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="@color/clear_red"
            android:text="@string/btn_clear"
            android:textSize="18sp"
            android:layout_marginBottom="20dp"/>

        <!-- Result Display -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:text="@string/default_result"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Bonus History Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:padding="12dp"
            android:text="No calculations yet"
            android:textColor="@color/secondary_gray"
            android:textSize="14sp"/>

    </LinearLayout>
</ScrollView>